{
	"compilerOptions": {
		"baseUrl": "./",
		"esModuleInterop": true,
		"lib": [
			"ES2023"
		],
		"module": "ESNext",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2022"
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src"
	]
}
